<Project Sdk="Microsoft.NET.Sdk">

  <!-- Probe gegen MessagePack 2.5.187 = die Version, die HrpcHub (Server) transitiv
       via SignalR.Protocols.MessagePack 8.0.14 resolved. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Hrpc.Spikes.MessagePack</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="2.5.187" />
  </ItemGroup>

  <!-- Die beiden .cs-Dateien im Verzeichnis werden vom SDK automatisch als Compile-
       Items für JEDES der beiden Projekte globbt — genau der geteilte Source, den wir
       brauchen (dieselben Files kompilieren gegen 2.5.187 bzw. 3.1.3). -->

</Project>