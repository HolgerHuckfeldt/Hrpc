<Project>

  <!-- Geteilte NuGet-Metadaten für alle Trame-Pakete, zentral versioniert.
       Pro-csproj verbleibt nur Paket-spezifisches: PackageId, Description,
       PackageReadmeFile, IsPackable, StaticWebAssetBasePath u. ä. -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Authors>Trame</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/HolgerHuckfeldt/Trame</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>