<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Hrpc.Server</PackageId>
    <Version>1.0.0</Version>
    <Authors>Hrpc</Authors>
    <Description>Unified ASP.NET Core server integration for Hrpc — AddHrpc + UseHrpcTransports + MapHrpc in einem Paket.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/HolgerHuckfeldt/Hrpc</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- ASP.NET Core-Typen (IApplicationBuilder/IEndpointRouteBuilder/MapHub) —
       Consumer ist ohnehin eine ASP.NET-App. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Aggregiert alle Transporte + DevUI; transitiv HrpcCore/HrpcCommon. -->
  <ItemGroup>
    <ProjectReference Include="..\HrpcHub\HrpcHub.csproj" />
    <ProjectReference Include="..\HrpcRest\HrpcRest.csproj" />
    <ProjectReference Include="..\HrpcWebSocket\HrpcWebSocket.csproj" />
    <ProjectReference Include="..\HrpcDeveloperUi\HrpcDeveloperUi.csproj" />
  </ItemGroup>

  <!-- Root-README ins Paket einbinden (löst NU5048-Warnung). -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>