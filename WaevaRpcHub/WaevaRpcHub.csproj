<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>WaevaRpc.Hub</PackageId>
    <Version>1.0.2</Version>
    <Authors>Hrpc</Authors>
    <Description>SignalR transport + AddWaevaRpc/UseWaevaRpc server integration for WaevaRpc RPC framework</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/HolgerHuckfeldt/WaevaRpc</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="8.0.14" />
  </ItemGroup>

  <!-- JsonElement-Formatter + WaevaRpcResponse-Formatter gegen die hier resolved
       MessagePack-Version (2.5.187, transitiv via SignalR.Protocols.MessagePack).
       Source geteilt mit WaevaRpcClient (dort 3.1.3). -->
  <ItemGroup>
    <Compile Include="..\WaevaRpcCommon\MessagePack\JsonElementMessagePackFormatter.cs" Link="MessagePack\JsonElementMessagePackFormatter.cs" />
    <Compile Include="..\WaevaRpcCommon\MessagePack\WaevaRpcResponseMessagePackFormatter.cs" Link="MessagePack\WaevaRpcResponseMessagePackFormatter.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WaevaRpcCore\WaevaRpcCore.csproj" />
  </ItemGroup>

</Project>
