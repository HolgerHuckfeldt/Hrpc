<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Hrpc.Hub</PackageId>
    <Version>1.0.1</Version>
    <Authors>Hrpc</Authors>
    <Description>SignalR transport for Hrpc RPC framework</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/HolgerHuckfeldt/Hrpc</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="8.0.14" />
  </ItemGroup>

  <!-- JsonElement-Formatter + HrpcResponse-Formatter gegen die hier resolved
       MessagePack-Version (2.5.187, transitiv via SignalR.Protocols.MessagePack).
       Source geteilt mit HrpcClient (dort 3.1.3). -->
  <ItemGroup>
    <Compile Include="..\HrpcCommon\MessagePack\JsonElementMessagePackFormatter.cs" Link="MessagePack\JsonElementMessagePackFormatter.cs" />
    <Compile Include="..\HrpcCommon\MessagePack\HrpcResponseMessagePackFormatter.cs" Link="MessagePack\HrpcResponseMessagePackFormatter.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HrpcCore\HrpcCore.csproj" />
  </ItemGroup>

</Project>
