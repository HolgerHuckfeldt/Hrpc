<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <GenerateRazorCompileOnBuild>false</GenerateRazorCompileOnBuild>
    <GenerateRazorCompileOnPublish>false</GenerateRazorCompileOnPublish>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>HrpcDeveloperUi</PackageId>
    <Version>0.1.0</Version>
    <Authors>Your Company</Authors>
    <Description>Developer UI for Hrpc (static web assets).</Description>
    <StaticWebAssetBasePath>developer</StaticWebAssetBasePath>
  </PropertyGroup>

  <!-- Rely on Razor SDK implicit wwwroot content -->
</Project>
