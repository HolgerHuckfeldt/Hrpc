<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>WaevaRpc.Common</PackageId>
    <Version>1.1.0</Version>
    <Authors>WaevaRpc</Authors>
    <Description>Shared models, attributes, and exceptions for WaevaRpc RPC framework</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/HolgerHuckfeldt/WaevaRpc</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Root-README als Paket-README einpacken (PackageReadmeFile=README.md) -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack.Annotations" Version="3.1.8" />
  </ItemGroup>

  <!-- System.Text.Json ist in net8.0 Teil des Frameworks, aber NICHT in der
       netstandard2.1-API-Oberfläche enthalten → für das netstandard2.1-Target
       explizit als Paket ziehen (Paket targetet selbst netstandard2.0, läuft also
       auf netstandard2.1). net8.0 braucht kein redundantes Paket. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- Der JsonElementMessagePackFormatter und WaevaRpcResponseMessagePackFormatter benötigen
       die volle MessagePack-Assembly, die WaevaRpcCommon nicht referenziert (nur Annotations).
       Die Dateien werden daher hier NICHT kompiliert, sondern per <Compile Include> in
       WaevaRpcHub + WaevaRpcClient gelinkt (jeweils gegen deren eigene MessagePack-Version). -->
  <ItemGroup>
    <Compile Remove="MessagePack\JsonElementMessagePackFormatter.cs" />
    <Compile Remove="MessagePack\WaevaRpcResponseMessagePackFormatter.cs" />
  </ItemGroup>

</Project>
