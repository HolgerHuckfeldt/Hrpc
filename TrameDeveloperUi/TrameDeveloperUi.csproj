<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <GenerateRazorCompileOnBuild>false</GenerateRazorCompileOnBuild>
    <GenerateRazorCompileOnPublish>false</GenerateRazorCompileOnPublish>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Trame.DeveloperUi</PackageId>
    <Version>1.1.0</Version>
    <Authors>Trame</Authors>
    <Description>Built-in developer web UI for Trame RPC framework</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/HolgerHuckfeldt/Trame</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <StaticWebAssetBasePath>developer-static</StaticWebAssetBasePath>
  </PropertyGroup>

  <!-- ASP.NET Core-Typen (IEndpointRouteBuilder) für die Wiring-Extension,
       die dieses Paket mitliefert. Consumer ist ohnehin eine ASP.NET-App. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Dev-Dateien der Svelte-Buildumgebung NICHT als Content/None ins NuGet
       packen (sonst werden sie dem Konsumenten als contentFiles ins Projekt
       injiziert). Die gebauten Assets liegen unter wwwroot/ und werden über
       den Static-Web-Assets-Mechanismus ausgeliefert. -->
  <ItemGroup>
    <None Remove="package.json;package-lock.json;tsconfig.json;tsconfig.test.json;vite.config.ts;svelte.config.js;vitest.config.ts;vitest.e2e.config.ts;index.html" />
    <Content Remove="package.json;package-lock.json;tsconfig.json;tsconfig.test.json;vite.config.ts;svelte.config.js;vitest.config.ts;vitest.e2e.config.ts;index.html" />
  </ItemGroup>

  <!-- Rely on Razor SDK implicit wwwroot content -->
</Project>
