@page "/developer"

@model HrpcDeveloperPage.DeveloperModel
@{
    ViewData["Title"] = "RPC Developer Interface";
}
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />

<div class="container mt-4" style="max-width:80%;">
    <h1>@ViewData["Title"]</h1>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    else if (Model.Controllers == null || Model.Controllers.Count == 0)
    {
        <p>Lade Discovery-Daten...</p>
    }
    else
    {
        <div id="controllers">
            @foreach (var ctrl in Model.Controllers)
            {
                <div class="card mb-3">
                    <div class="card-header">
                        <button class="btn btn-link text-left" type="button" data-toggle="collapse" data-target="#ctrl_@ctrl.Name" aria-expanded="false">
                            @ctrl.Name
                        </button>
                    </div>
                    <div id="ctrl_@ctrl.Name" class="collapse">
                        <ul class="list-group list-group-flush">
                            @foreach (var method in ctrl.Methods)
                            {
                                <li class="list-group-item">
                                    <button class="btn btn-link text-left method-btn" onclick="selectMethod('@ctrl.Name', '@method.MethodName')">
                                        <span class="badge badge-primary">GET</span>
                                        @method.MethodName (@string.Join(", ", method.Parameters.Select(p => p.ParameterType + " " + p.ParameterName)))
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    }

    <div id="callSection" style="display:none;" class="mt-4">
        <h2>Call: <span id="callTitle"></span></h2>
        <form id="callForm">
            <div id="parameters"></div>
            <button type="submit" class="btn btn-primary">Aufruf starten</button>
        </form>
        <div id="resultSection" style="display:none;" class="mt-3">
            <h3>Ergebnis:</h3>
            <div class="result-item">
                <strong>Status-Code:</strong> <span id="statusCode"></span>
            </div>
            <div class="result-item">
                <strong>Id:</strong> <span id="resultId"></span>
            </div>
            <div class="result-item">
                <strong>Data:</strong>
                <pre id="resultData"></pre>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Die Discovery-Daten werden als JSON-String in das Model eingebettet.
        var controllers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Controllers));
        var selectedControllerName = "";
        var selectedMethodName = "";
        var selectedMethod = null;

        function selectMethod(ctrlName, methodName) {
            selectedControllerName = ctrlName;
            selectedMethodName = methodName;
            // Finde die Methode in den Discovery-Daten
            for (var i = 0; i < controllers.length; i++) {
                if (controllers[i].name === ctrlName) {
                    var methods = controllers[i].methods;
                    for (var j = 0; j < methods.length; j++) {
                        if (methods[j].methodName === methodName) {
                            selectedMethod = methods[j];
                            break;
                        }
                    }
                    break;
                }
            }
            document.getElementById("callTitle").innerText = ctrlName + "." + methodName;
            // Erzeuge dynamisch Parameterfelder
            var paramDiv = document.getElementById("parameters");
            paramDiv.innerHTML = "";
            if (selectedMethod?.parameters?.length > 0) {
                selectedMethod.parameters.forEach(function(param) {
                    var group = document.createElement("div");
                    group.className = "form-group";
                    var label = document.createElement("label");
                    label.innerText = param.parameterName + " (" + param.parameterType + ")";
                    var input = document.createElement("input");
                    input.type = "text";
                    input.name = param.parameterName;
                    input.className = "form-control";
                    group.appendChild(label);
                    group.appendChild(input);
                    paramDiv.appendChild(group);
                });
            }
            document.getElementById("callSection").style.display = "block";
            document.getElementById("resultSection").style.display = "none";
        }

        document.getElementById("callForm").addEventListener("submit", function(e){
            e.preventDefault();
            var formData = new FormData(e.target);
            var paramsArray = [];
            for (var pair of formData.entries()){
                paramsArray.push({ parameterName: pair[0], data: pair[1] });
            }
            var requestPayload = {
                controller: selectedControllerName,
                method: selectedMethodName,
                stringData: JSON.stringify(paramsArray),
                id: selectedControllerName + "." + selectedMethodName,
                // dependsOn wird nicht mehr genutzt, dataPath bleibt als Platzhalter
                dataPath: "$"
            };

            fetch("/api/hrpc/json", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(requestPayload)
            })
            .then(response => response.json())
            .then(data => {
                document.getElementById("statusCode").innerText = data.code;
                document.getElementById("resultId").innerText = data.id;
                try {
                    // Versuche, Data als JSON zu parsen
                    document.getElementById("resultData").innerText = JSON.stringify(JSON.parse(data.data), null, 2);
                } catch (e) {
                    document.getElementById("resultData").innerText = data.data;
                }
                document.getElementById("resultSection").style.display = "block";
            })
            .catch(err => {
                document.getElementById("resultData").innerText = "Fehler: " + err;
                document.getElementById("resultSection").style.display = "block";
            });
        });
    </script>
}
